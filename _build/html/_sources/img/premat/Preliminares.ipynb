   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "3723c65b",
   "metadata": {},
   "outputs": [],
   "source": [
    "t = np.linspace(-np.pi, np.pi)\n",
    "x = np.cos(t)\n",
    "y = np.sin(t)\n",
    "\n",
    "y1 = np.arctan(y/x)\n",
    "y2 = np.arctan2(y,x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "5298320f",
   "metadata": {},
   "outputs": [
